rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function email() { return request.auth.token.email; }
    function meExists() { return signedIn() && exists(/databases/$(database)/documents/portalUsers/$(email())); }
    function me() { return get(/databases/$(database)/documents/portalUsers/$(email())).data; }
    function activeUser() { return meExists() && me().enabled == true; }
    function admin() { return activeUser() && me().role == 'admin'; }
    function ownsAssistant() {
      return activeUser()
        && resource.data.role == 'assistant'
        && resource.data.ownerEmail == email();
    }
    function createsOwnAssistant() {
      return activeUser()
        && request.resource.data.role == 'assistant'
        && request.resource.data.ownerEmail == email();
    }
    function updatesOwnAssistant() {
      return ownsAssistant()
        && request.resource.data.role == 'assistant'
        && request.resource.data.ownerEmail == email()
        && request.resource.data.email == resource.data.email;
    }

    match /portalUsers/{userEmail} {
      allow read: if activeUser();
      allow create: if admin() || createsOwnAssistant();
      allow update: if admin() || updatesOwnAssistant();
      allow delete: if admin() || ownsAssistant();
    }
    match /systems/{systemId} {
      allow read: if activeUser();
      allow create, update, delete: if admin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
