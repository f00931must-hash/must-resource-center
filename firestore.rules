rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function email() { return request.auth.token.email; }
    function meExists() { return signedIn() && exists(/databases/$(database)/documents/portalUsers/$(email())); }
    function me() { return get(/databases/$(database)/documents/portalUsers/$(email())).data; }
    function activeUser() { return meExists() && me().enabled == true; }
    function admin() { return activeUser() && me().role == 'admin'; }
    function rootAdmin() { return activeUser() && email() == 'master004400@gmail.com'; }
    function budgetRoleManager() {
      return activeUser() && (
        rootAdmin()
        || email() == 'dreamjoy126@gmail.com'
        || me().get('specialAccess', {}).get('budgetRoles', false) == true
      );
    }
    function changesSpecialAccess() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'specialAccess', 'specialAccessUpdatedAt', 'specialAccessUpdatedBy'
      ]);
    }
    function changesBudgetRole() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'budgetRole', 'budgetRoleUpdatedAt'
      ]);
    }
    function changesOnlyBudgetRole() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'budgetRole', 'budgetRoleUpdatedAt'
      ]);
    }
    function ownsAssistant() {
      return activeUser()
        && resource.data.role == 'assistant'
        && resource.data.ownerEmail == email();
    }
    function createsOwnAssistant() {
      return activeUser()
        && request.resource.data.role == 'assistant'
        && request.resource.data.ownerEmail == email();
    }
    function updatesOwnAssistant() {
      return ownsAssistant()
        && request.resource.data.role == 'assistant'
        && request.resource.data.ownerEmail == email()
        && request.resource.data.email == resource.data.email;
    }

    match /portalUsers/{userEmail} {
      allow read: if activeUser();
      allow create: if rootAdmin()
        || (admin() && !request.resource.data.keys().hasAny(['specialAccess','specialAccessUpdatedAt','specialAccessUpdatedBy','budgetRole','budgetRoleUpdatedAt']))
        || createsOwnAssistant();
      allow update: if rootAdmin()
        || (admin() && !changesSpecialAccess() && !changesBudgetRole())
        || (budgetRoleManager() && changesOnlyBudgetRole())
        || updatesOwnAssistant();
      allow delete: if admin() || ownsAssistant();
    }
    match /systems/{systemId} {
      allow read: if activeUser();
      allow create, update, delete: if rootAdmin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
