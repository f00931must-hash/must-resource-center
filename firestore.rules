rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }
    function email() {
      return request.auth.token.email.lower();
    }
    function userDoc() {
      return get(/databases/$(database)/documents/portalUsers/$(email()));
    }
    function activeUser() {
      return signedIn() && exists(/databases/$(database)/documents/portalUsers/$(email())) && userDoc().data.enabled == true;
    }
    function admin() {
      return activeUser() && userDoc().data.role == 'admin';
    }

    match /portalUsers/{userEmail} {
      allow read: if activeUser() && (admin() || userEmail == email());
      allow create, update, delete: if admin();
    }

    match /systems/{systemId} {
      allow read: if activeUser();
      allow create, update, delete: if admin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
